# ═══════════════════════════════════════════════════════════
# BondIQ — Environment Variables Template
# ═══════════════════════════════════════════════════════════
# Copy to .env and fill in your real values.
# This file is safe to commit. .env is NOT.

# ── Gemini AI (free key at https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Supabase — Authentication + Database
# Get from: https://app.supabase.com/ → Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
